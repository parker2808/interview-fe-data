        {
          "type": "list",
          "style": "ul",
          "items": [
            {
              "en": "Which devices actually have to be supported?",
              "vi": "Device nào thực sự phải support?"
            },
            {
              "en": "How does the table behave on a small screen?",
              "vi": "Table xử lý thế nào trên màn nhỏ?"
            },
            {
              "en": "Is some content more important than the rest?",
              "vi": "Có content nào ưu tiên hơn content khác?"
            },
            {
              "en": "Are touch targets large enough?",
              "vi": "Touch target có đủ lớn?"
            }
          ]
        }
      ]
    },
